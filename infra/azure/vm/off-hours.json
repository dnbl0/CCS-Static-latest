{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Switches the VM off (deallocated: no compute charge) from stopHour to startHour every day, Melbourne time. Two small Logic Apps (consumption plan, a few cents a month), each with a managed identity that may only start/stop this one VM. Deploy: az deployment group create -g ccs-web-rg --template-file infra/azure/vm/off-hours.json. Change the hours with the parameters; redeploying updates them. See infra/azure/README.md."
  },
  "parameters": {
    "vmName": { "type": "string", "defaultValue": "ccs-vm" },
    "location": { "type": "string", "defaultValue": "newzealandnorth", "metadata": { "description": "Must be a region the subscription allows." } },
    "stopHour": { "type": "int", "defaultValue": 0, "minValue": 0, "maxValue": 23 },
    "startHour": { "type": "int", "defaultValue": 6, "minValue": 0, "maxValue": 23 },
    "timeZone": { "type": "string", "defaultValue": "AUS Eastern Standard Time", "metadata": { "description": "Windows time zone name; follows daylight saving." } }
  },
  "variables": {
    "vmId": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
    "vmContributor": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '9980e02c-c2be-4d73-94e8-173b1dc7cf3c')]",
    "jobs": [
      { "suffix": "stop", "action": "deallocate" },
      { "suffix": "start", "action": "start" }
    ]
  },
  "resources": [
    {
      "copy": { "name": "workflows", "count": "[length(variables('jobs'))]" },
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[concat(parameters('vmName'), '-', variables('jobs')[copyIndex()].suffix)]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "timeZone": "[parameters('timeZone')]",
                "schedule": { "hours": [ "[if(equals(variables('jobs')[copyIndex()].suffix, 'stop'), string(parameters('stopHour')), string(parameters('startHour')))]" ], "minutes": [ 0 ] }
              }
            }
          },
          "actions": {
            "Call_Azure": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "[concat('https://management.azure.com', variables('vmId'), '/', variables('jobs')[copyIndex()].action, '?api-version=2024-07-01')]",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" }
              },
              "runAfter": {}
            }
          },
          "outputs": {}
        }
      }
    },
    {
      "copy": { "name": "roles", "count": "[length(variables('jobs'))]" },
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[concat('Microsoft.Compute/virtualMachines/', parameters('vmName'))]",
      "name": "[guid(variables('vmId'), variables('jobs')[copyIndex()].suffix, variables('vmContributor'))]",
      "dependsOn": [ "[resourceId('Microsoft.Logic/workflows', concat(parameters('vmName'), '-', variables('jobs')[copyIndex()].suffix))]" ],
      "properties": {
        "roleDefinitionId": "[variables('vmContributor')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', concat(parameters('vmName'), '-', variables('jobs')[copyIndex()].suffix)), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}
