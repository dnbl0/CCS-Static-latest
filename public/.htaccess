<IfModule mod_rewrite.c>
  RewriteEngine On
  # Collection landing pages were removed: each collection opens the search results filtered to it
  RewriteRule ^collections/grainger-museum(/|/index\.html)?$ /search/search-results.html?collection=Grainger\%20Museum\%20Collection [R=301,NE,L]
  RewriteRule ^collections/harry-brookes-allen-museum(/|/index\.html)?$ /search/search-results.html?collection=Harry\%20Brookes\%20Allen\%20Museum\%20of\%20Anatomy\%20and\%20Pathology [R=301,NE,L]
  RewriteRule ^collections/henry-forman-atkinson-dental-museum(/|/index\.html)?$ /search/search-results.html?collection=Henry\%20Forman\%20Atkinson\%20Dental\%20Museum [R=301,NE,L]
  RewriteRule ^collections/medical-history-museum(/|/index\.html)?$ /search/search-results.html?collection=Medical\%20History\%20Museum [R=301,NE,L]
  RewriteRule ^collections/university-art-collection(/|/index\.html)?$ /search/search-results.html?collection=University\%20Art\%20Collection [R=301,NE,L]
  RewriteBase /

  # --- Legacy filename redirects (301) to new clean URLs ---
  RewriteRule ^Contact\ Us\.dc\.html$ /help/index.html#access [R=301,NE,L]
  RewriteRule ^Collection\ Record\.dc\.html$ /collections/record [R=301,L,QSA]
  RewriteRule ^item/(CA-[0-9]+)$ /collections/record?item=$1 [L]
  RewriteRule ^Collection\ Search\ v3\.dc\.html$ /search/search-results [R=301,L,QSA]
  RewriteRule ^Browse\ Collections\.dc\.html$ /collections [R=301,L]
  RewriteRule ^Collection\ Landing\.dc\.html$ /collections [R=301,L]
  RewriteRule ^Help\ and\ Support\.dc\.html$ /help [R=301,L,QSA]
  RewriteRule ^CCS\ Home\ page\.dc\.html$ / [R=301,L]
  RewriteRule ^search\.html$ /search/search-results [R=301,L,QSA]
  RewriteRule ^search/?$ /search/search-results [R=301,L,QSA]
  RewriteRule ^search/advanced(\.html)?/?$ /search/search-results [R=301,L,QSA]

  # --- Clean URL rewriting (internal, URL bar stays clean) ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^search/search-results/?$ search/search-results.html [L]
  RewriteRule ^search/advanced-search/?$ search/advanced-search.html [L]
  RewriteRule ^collections/record/?$ collections/record.html [L]
  RewriteRule ^collections/([a-z0-9-]+)/?$ collections/$1.html [L]
  RewriteRule ^collections/?$ collections/index.html [L]
  RewriteRule ^help/?$ help/index.html [L]
  RewriteRule ^help/([a-z0-9-]+)/?$ help/$1.html [L]
  RewriteRule ^contact(\.html)?/?$ /help/index.html#access [R=301,NE,L]
</IfModule>
