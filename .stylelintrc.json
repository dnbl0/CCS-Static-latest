{
  "extends": "stylelint-config-recommended",
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "ead-ccs-test/**",
    "public/styles/vendor/**",
    "public/assets/**"
  ],
  "rules": {
    "declaration-no-important": [
      true,
      {
        "severity": "warning"
      }
    ],
    "selector-max-id": [
      0,
      {
        "severity": "warning"
      }
    ],
    "no-descending-specificity": null,
    "no-duplicate-selectors": [
      true,
      {
        "severity": "warning"
      }
    ],
    "property-no-deprecated": [
      true,
      {
        "ignoreProperties": [
          "clip"
        ]
      }
    ],
    "declaration-property-value-keyword-no-deprecated": [
      true,
      {
        "ignoreKeywords": [
          "break-word"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "public/styles/tokens/**"
      ],
      "rules": {
        "no-duplicate-selectors": null
      }
    }
  ]
}
