<header class="documentHeader bg-primary text-center rounded px-3 py-4">
  <%= content_tag @as, class: @classes do %>
    <% before_titles.each do |t| %>
      <%= t %>
    <% end %>

    <%= counter -%><%= title -%>

    <% after_titles.each do |t| %>
      <%= t %>
    <% end %>
  <% end %>

  <% actions.each do |action| %>
    <%= action %>
  <% end %>
</header>
