<%= content_tag @component,
  id: @id,
  data: {
    'document-id': document.id.to_s.parameterize,
    'document-counter': counter,
  },
  itemscope: true,
  itemtype: document.itemtype,
  class: classes.flatten.join(' ') do %>
  <%= header %>
  <% if body.present? %>
    <%= body %>
  <% else %>
    <div class="document-main-section vstack gap-4">
      <%= title %>
      <%= embed %>
      <%= content %>
      <div class="row g-4">
        <div class="col-lg-7"><%= metadata %></div>
        <% if copyright_fields.any? %>
          <div class="col-lg-5"><%= render StockObjectDetailsComponent.new(heading: "Copyright", fields: copyright_fields, show: true) %></div>
        <% end %>
      </div>

      <% partials.each do |partial| %>
        <%= partial %>
      <% end %>
    </div>

    <%= thumbnail %>
  <% end %>
  <%= footer %>
<% end %>
