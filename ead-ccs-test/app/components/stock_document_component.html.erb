<%= content_tag @component,
  id: @id,
  data: {
    'document-id': document.id.to_s.parameterize,
    'document-counter': counter,
  },
  itemscope: true,
  itemtype: document.itemtype,
  class: classes.flatten.join(' ') do %>
  <%= header %>
  <% if body.present? %>
    <%= body %>
  <% else %>
    <div class="document-main-section vstack gap-4">
      <%= embed %>
      <div class="row justify-content-center">
        <div class="col-lg-10 vstack gap-4">
          <%= title %>
          <%= content %>

          <% if collections.any? %>
            <p class="m-0">
              This item is provided and maintained by
              <% collections.each do |collection| %>
                <a href="<%= collection_path("collection_ssim", collection) %>" class="btn btn-light btn-sm rounded-pill ms-1"><%= collection %></a>
              <% end %>
            </p>
          <% end %>

          <div>
            <ul class="nav nav-tabs" role="tablist">
              <% { "good-to-know" => "Good to know", "object-details" => "Object details", "copyright" => "Copyright", "permalink" => "Permalink" }.each_with_index do |(id, title), index| %>
                <li class="nav-item" role="presentation">
                  <button class="nav-link<%= " active" if index.zero? %>" id="<%= id %>-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#<%= id %>-pane" aria-controls="<%= id %>-pane" aria-selected="<%= index.zero? %>"><%= title %></button>
                </li>
              <% end %>
            </ul>
            <div class="tab-content">
              <div class="tab-pane fade show active" id="good-to-know-pane" role="tabpanel" aria-labelledby="good-to-know-tab" tabindex="0">
                <%= render StockObjectDetailsComponent.new(fields: good_to_know_fields, show: true) %>
              </div>
              <div class="tab-pane fade" id="object-details-pane" role="tabpanel" aria-labelledby="object-details-tab" tabindex="0">
                <%= render StockObjectDetailsComponent.new(fields: object_fields, show: true) %>
              </div>
              <div class="tab-pane fade" id="copyright-pane" role="tabpanel" aria-labelledby="copyright-tab" tabindex="0">
                <%= render StockObjectDetailsComponent.new(fields: copyright_fields, show: true) %>
                <p class="mt-3 mb-0"><a href="/help#copyright" class="fw-bold">About copyright and terms of use</a></p>
              </div>
              <div class="tab-pane fade" id="permalink-pane" role="tabpanel" aria-labelledby="permalink-tab" tabindex="0" data-controller="clipboard">
                <div class="py-3 border-bottom border-secondary-subtle">
                  <label for="permalink-url" class="fw-bold d-block mb-2">Persistent link</label>
                  <div class="input-group">
                    <input id="permalink-url" type="text" class="form-control" value="<%= permalink %>" readonly autocomplete="off" data-clipboard-target="source">
                    <button type="button" class="btn btn-outline-primary" data-action="clipboard#copy" data-clipboard-target="button"><span data-clipboard-target="label">Copy link</span></button>
                  </div>
                  <p class="visually-hidden" role="status" data-clipboard-target="status"></p>
                </div>
                <p class="mt-3 mb-2"><%= accession_number ? "Quote the accession number #{accession_number} when contacting the collection team." : "Quote this link when contacting the collection team." %></p>
                <a href="<%= permalink %>" class="fw-bold">View full record</a>
              </div>
            </div>
          </div>

          <% if collections.any? || named_collections.any? %>
            <section aria-labelledby="related-collections-heading">
              <h2 id="related-collections-heading" class="h6 text-uppercase mb-3">Discover related collections</h2>
              <div class="d-flex flex-wrap gap-2">
                <% collections.each do |collection| %>
                  <a href="<%= collection_path("collection_ssim", collection) %>" class="btn btn-light rounded-pill"><%= collection %></a>
                <% end %>
                <% named_collections.each do |collection| %>
                  <a href="<%= collection_path("named_collection_ssim", collection) %>" class="btn btn-light rounded-pill"><%= collection %></a>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      </div>

      <% partials.each do |partial| %>
        <%= partial %>
      <% end %>
    </div>

    <%= thumbnail %>
  <% end %>
  <%= footer %>
<% end %>
