<%= content_tag @component,
  id: @id,
  data: {
    'document-id': document.id.to_s.parameterize,
    'document-counter': counter,
  },
  itemscope: true,
  itemtype: document.itemtype,
  class: classes.flatten.join(' ') do %>
  <%= header %>
  <% if body.present? %>
    <%= body %>
  <% else %>
    <article class="document-main-section mx-auto col-lg-10 vstack gap-4">
      <%= embed %>
      <%= title %>
      <%= content %>

      <% if collections.any? %>
        <p class="m-0">
          This item is provided and maintained by
          <% collections.each do |collection| %>
            <a href="<%= collection_path("collection_ssim", collection) %>" class="btn btn-light btn-sm rounded-pill ms-1"><%= collection %></a>
          <% end %>
        </p>
      <% end %>

      <section aria-label="Record details">
        <ul class="nav nav-tabs" role="tablist">
          <% { "object-details" => "Object details", "copyright" => "Copyright", "permalink" => "Permalink" }.each_with_index do |(id, label), index| %>
            <li class="nav-item" role="presentation">
              <button class="nav-link<%= " active" if index.zero? %>" id="<%= id %>-tab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#<%= id %>-pane" aria-controls="<%= id %>-pane" aria-selected="<%= index.zero? %>"><%= label %></button>
            </li>
          <% end %>
        </ul>
        <section class="tab-content" aria-live="off">
          <section class="tab-pane fade show active" id="object-details-pane" role="tabpanel" aria-labelledby="object-details-tab" tabindex="0">
            <%= render StockObjectDetailsComponent.new(fields: object_fields, show: true) %>
          </section>
          <section class="tab-pane fade" id="copyright-pane" role="tabpanel" aria-labelledby="copyright-tab" tabindex="0">
            <%= render StockObjectDetailsComponent.new(fields: copyright_fields, show: true) %>
            <p class="mt-3 mb-0"><a href="/help#copyright" class="fw-bold">About copyright and terms of use</a></p>
          </section>
          <section class="tab-pane fade" id="permalink-pane" role="tabpanel" aria-labelledby="permalink-tab" tabindex="0">
            <section class="table-responsive">
              <table class="table table-borderless document-metadata mb-0" data-controller="clipboard">
                <tbody>
                  <tr>
                    <th scope="row" class="blacklight-persistent_link fw-bold w-25 ps-0 py-3 border-bottom border-secondary-subtle">Persistent link</th>
                    <td class="blacklight-persistent_link pe-0 py-3 border-bottom border-secondary-subtle">
                      <a href="<%= permalink %>" class="text-break" data-clipboard-target="source" data-copy="<%= permalink %>"><%= permalink %></a>
                      <button type="button" class="btn btn-link p-0 ms-2 align-text-bottom lh-1" data-action="clipboard#copy" data-clipboard-target="button" data-tooltip-title="Copy link" aria-label="Copy link">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="9" y="9" width="11" height="11" rx="1" /><path d="M5 15V5a1 1 0 0 1 1-1h10" /></svg>
                        <span class="small" data-clipboard-target="label"></span>
                      </button>
                      <output class="visually-hidden" data-clipboard-target="status"></output>
                    </td>
                  </tr>
                  <tr>
                    <th scope="row" class="blacklight-contact fw-bold w-25 ps-0 py-3 border-bottom border-secondary-subtle">Contacting the team</th>
                    <td class="blacklight-contact pe-0 py-3 border-bottom border-secondary-subtle"><%= accession_number ? "Quote the accession number #{accession_number} when contacting the collection team." : "Quote this link when contacting the collection team." %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="blacklight-full_record fw-bold w-25 ps-0 py-3 border-bottom border-secondary-subtle">Full record</th>
                    <td class="blacklight-full_record pe-0 py-3 border-bottom border-secondary-subtle"><a href="<%= permalink %>" class="fw-bold">View full record</a></td>
                  </tr>
                </tbody>
              </table>
            </section>
          </section>
        </section>
      </section>

      <% partials.each do |partial| %>
        <%= partial %>
      <% end %>
    </article>

    <%= thumbnail %>
  <% end %>
  <%= footer %>
<% end %>
