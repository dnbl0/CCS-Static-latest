<tr>
  <th scope="row" class="blacklight-<%= @key %> fw-bold w-25 ps-0 py-3 border-bottom border-secondary-subtle"><%= label %></th>
  <td class="blacklight-<%= @key %> pe-0 py-3 border-bottom border-secondary-subtle">
    <% values.each do |value| %>
      <div><%= value %></div>
    <% end %>
  </td>
</tr>
