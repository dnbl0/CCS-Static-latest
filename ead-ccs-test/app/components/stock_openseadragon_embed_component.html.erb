<%# The media band goes to the layout (content_for :hero), above the page container. Icons are Material's paths, filled with the text colour. %>
<% hero = capture do %>
  <%# One wrapper for the band, toolbar and modal: OpenSeadragon, in full screen, takes the page body's children off and remembers where its toolbar was from the toolbar's parent, which must not be the body itself. %>
  <article aria-label="Media">
  <%# The focus ring of the controls on the dark band: Bootstrap's own variable, near-opaque white (its light ring is 25% white, about 2:1 on black; WCAG 1.4.11 asks 3:1) %>
  <section class="bg-black text-white" aria-label="Media viewer" style="--bs-focus-ring-color: rgba(255, 255, 255, .9)">
    <header class="container text-center py-5">
      <p class="display-6 text-white m-0" aria-hidden="true"><%= presenter.heading %></p>
    </header>

    <article class="container pb-3 d-flex align-items-center gap-3">
      <% if count > 1 %>
        <button type="button" id="<%= @id_prefix %>-previous" class="btn btn-dark rounded-circle p-2 lh-1 flex-shrink-0 focus-ring" title="Previous image" aria-label="Previous image">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" /></svg>
        </button>
      <% end %>
      <figure class="flex-grow-1 m-0">
        <%= helpers.openseadragon_picture_tag image, id: viewer_id, role: 'img', 'aria-label': image_label(1), class: 'osd-image d-block border-0 bg-black', style: 'height: 616px', data: { openseadragon: count > 1 ? osd_config_referencestrip.merge(osd_config) : osd_config } %>
      </figure>
      <% if count > 1 %>
        <button type="button" id="<%= @id_prefix %>-next" class="btn btn-dark rounded-circle p-2 lh-1 flex-shrink-0 focus-ring" title="Next image" aria-label="Next image">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" /></svg>
        </button>
      <% end %>
    </article>

    <% if count > 1 %>
      <nav class="container pb-4" aria-label="Images" data-media-thumbnails data-viewer="<%= viewer_id %>">
        <ul class="list-unstyled d-flex justify-content-center flex-wrap gap-2 m-0 p-0">
          <% thumbnails.each_with_index do |url, index| %>
            <li>
              <button type="button" class="btn p-0 border border-2 border-transparent rounded-0 focus-ring" data-page="<%= index %>" data-label="<%= image_label(index + 1) %>" aria-label="Image <%= index + 1 %> of <%= count %>">
                <img src="<%= url %>" alt="" width="80" height="80" class="d-block object-fit-cover">
              </button>
            </li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </section>

  <section id="<%= @id_prefix %>-toolbar" class="bg-body-tertiary" aria-label="Media toolbar">
    <div class="container d-flex align-items-center justify-content-end py-2">
      <menu class="list-unstyled d-flex gap-1 m-0 p-0">
        <% if media_fields.any? %>
          <li>
            <button type="button" class="btn btn-link p-1 lh-1" data-bs-toggle="modal" data-bs-target="#<%= @id_prefix %>-media-metadata" data-tooltip-title="Media metadata" aria-label="Media metadata">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" /></svg>
            </button>
          </li>
        <% end %>
        <li>
          <button type="button" id="<%= @id_prefix %>-full-page" class="btn btn-link p-1 lh-1" data-tooltip-title="Full screen" aria-label="Full screen">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" /></svg>
          </button>
        </li>
      </menu>
    </div>
  </section>

  <% if media_fields.any? %>
    <aside class="modal fade" id="<%= @id_prefix %>-media-metadata" tabindex="-1" aria-labelledby="<%= @id_prefix %>-media-metadata-title" aria-hidden="true">
      <article class="modal-dialog modal-dialog-centered modal-lg">
        <section class="modal-content">
          <header class="modal-header">
            <h2 class="modal-title h5" id="<%= @id_prefix %>-media-metadata-title">Media metadata</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </header>
          <section class="modal-body">
            <%= render StockObjectDetailsComponent.new(fields: media_fields, show: true) %>
          </section>
        </section>
      </article>
    </aside>
  <% end %>
  </article>
<% end %>
<% helpers.content_for(:hero, hero) %>
