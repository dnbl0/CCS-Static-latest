<button type="button" class="filters-toggle d-lg-none" aria-haspopup="dialog"
        data-controller="filter-toggle" data-action="filter-toggle#open">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="18" x2="20" y2="18" /><circle cx="15" cy="6" r="2.2" fill="currentColor" /><circle cx="8" cy="12" r="2.2" fill="currentColor" /><circle cx="13" cy="18" r="2.2" fill="currentColor" /></svg>
  <span>Filters</span>
  <% if applied_count.positive? %>
    <span class="filters-toggle__count"><%= applied_count %><span class="visually-hidden"> applied</span></span>
  <% end %>
</button>
