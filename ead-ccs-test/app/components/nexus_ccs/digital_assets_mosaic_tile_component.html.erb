<%# The tile is the asset's own shape: its aspect-ratio is the asset's width over its height (--ratio), and a row shares its width among its tiles in
    that proportion, so the tiles of a row are the same height and none has room around its asset. %>
<button type="button" class="digital-assets-mosaic__tile <%= visibility %> position-relative p-0 border border-light-subtle bg-white overflow-hidden focus-ring" aria-label="<%= accessible_name %>"
        style="--ratio: <%= ratio.round(4) %>" data-mosaic-target="tile" data-action="mosaic#open" data-mosaic-index-param="<%= item[:position] %>">
  <% if image? %>
    <%= image_tag item[:large], alt: "", class: "d-block w-100 h-100 object-fit-contain" %>
  <% else %>
    <span class="d-flex flex-column align-items-center justify-content-center gap-1 w-100 h-100 p-2 bg-primary text-white text-center">
      <span class="fs-3 lh-1"><%= kind_icon %></span>
      <span class="small text-truncate w-100"><%= name %></span>
    </span>
  <% end %>
  <% if more.positive? %>
    <span class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-black bg-opacity-50 text-white fs-4 fw-semibold" aria-hidden="true">+<%= more %></span>
  <% end %>
</button>
