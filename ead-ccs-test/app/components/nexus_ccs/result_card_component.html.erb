<%= content_tag @component,
  id: @id,
  data: { "document-id": document.id.to_s.parameterize, "document-counter": counter },
  itemscope: true,
  itemtype: document.itemtype,
  class: card_classes.join(" ") do %>
  <% if media? %>
    <%= link_to document_path, class: "result-card__media", tabindex: -1, "aria-hidden": true do %>
      <%= image_tag media_path, alt: "", loading: "lazy" %>
    <% end %>
  <% end %>
  <div class="result-card__content">
    <%= title %>
    <% if lines.any? %>
      <ul class="result-card__lines">
        <% lines.each do |line| %><li><%= line %></li><% end %>
      </ul>
    <% end %>
    <div class="result-card__save"><%= render NexusCcs::SaveControlComponent.new(document: document) %></div>
  </div>
<% end %>
