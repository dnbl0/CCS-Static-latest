<div id="search-overlay" class="search-overlay" role="dialog" aria-modal="true" aria-labelledby="search-overlay-title"
     data-controller="search-overlay"
     data-action="search-overlay:open@window->search-overlay#open keydown.esc@window->search-overlay#close">
  <div class="search-overlay__inner">
    <h2 id="search-overlay-title" class="visually-hidden">Search</h2>
    <%= form_with url: search_catalog_path, method: :get, class: "search-overlay__form", html: { role: "search" } do |form| %>
      <%= form.label :q, "Search Cultural Collections", for: "search-overlay-input", class: "visually-hidden" %>
      <%= form.search_field :q, id: "search-overlay-input", placeholder: "Search", autocomplete: "off", maxlength: QueryRules::MAX_LENGTH, data: { search_overlay_target: "input" } %>
      <button type="submit" class="search-overlay__submit" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    <% end %>
    <% if recent_searches.any? %>
      <nav class="search-overlay__recent" aria-label="Recent searches">
        <h3 class="search-overlay__recent-heading">Recent searches</h3>
        <ul class="search-overlay__recent-list">
          <% recent_searches.each do |search| %>
            <li><%= link_to_search(search) %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
    <button type="button" class="search-overlay__close" aria-label="Close search" data-action="search-overlay#close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span>Close</span>
    </button>
  </div>
</div>
