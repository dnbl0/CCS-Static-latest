<%# data-bs-theme="light": the site's own styling is light only, but Blacklight's layout sets Bootstrap's theme from the computer's (dark turns the theme-aware classes dark under dark text). Bootstrap's grid, ratio and utility classes; digital_assets.css holds the height that fits the tiles to the screen. %>
<%# A row's tiles share its width in proportion to their shapes; the grid's width is capped (in the stylesheet) so all the rows fit the screen. %>
<% grid = capture do %>
  <div class="digital-assets-mosaic__grid position-relative d-flex flex-column gap-2 mx-auto" data-mosaic-target="grid">
    <% last_row = mosaic_rows.size - 1 %>
    <% mosaic_rows.each_with_index do |row, row_index| %>
      <div class="digital-assets-mosaic__row <%= row_index.zero? ? 'd-flex' : 'd-none d-lg-flex' %> gap-2" data-mosaic-target="row">
        <% row.each_with_index do |item, index| %>
          <%= tile(item, first: row_index.zero? && index.zero?, more: (split? && row_index == last_row && index == row.size - 1) ? more : 0) %>
        <% end %>
      </div>
    <% end %>

    <% unless split? %>
      <button type="button" class="btn btn-light position-absolute bottom-0 end-0 m-3 shadow-sm" data-action="mosaic#open" data-mosaic-index-param="0">
        Show all <span class="fw-semibold"><%= count %></span><span class="visually-hidden"> digital <%= "asset".pluralize(count) %></span>
      </button>
    <% end %>
  </div>
<% end %>

<% by_kind = capture do %>
  <% if kinds.size > 0 %>
    <nav aria-label="Digital assets by type">
      <ul class="list-unstyled d-flex flex-wrap gap-2 m-0">
        <% kinds.each do |kind, label, number, position| %>
          <li>
            <button type="button" class="btn btn-outline-primary btn-sm" data-action="mosaic#open" data-mosaic-index-param="<%= position %>">
              <%= label %> <span class="badge text-bg-primary"><%= number %></span>
            </button>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>

<section class="digital-assets-mosaic <%= 'digital-assets-mosaic--split' if split? %> container py-4" data-bs-theme="light" data-controller="mosaic" aria-labelledby="digital-assets-heading">
  <h2 id="digital-assets-heading" class="visually-hidden">Digital <%= "asset".pluralize(count) %></h2>

  <% if split? %>
    <%# The title and details on the left (a third of the width), the gallery on the right %>
    <div class="row g-4 align-items-start">
      <article class="col-lg-4" aria-label="About this record">
        <% if summary.eyebrow %><p class="small text-uppercase fw-semibold text-secondary-emphasis mb-2"><%= summary.eyebrow %></p><% end %>
        <p class="h2 mb-3"><%= title %></p>
        <% if summary.byline %><p class="lead mb-3"><%= summary.byline %></p><% end %>
        <% if summary.licence %><p class="d-inline-flex align-items-center gap-2 mb-4 px-2 py-1 bg-body-secondary small"><span class="visually-hidden">Licence: </span><%= summary.licence %></p><% end %>
        <button type="button" class="btn btn-primary d-block mb-3" data-action="mosaic#open" data-mosaic-index-param="0">
          View all <%= count %> digital <%= "asset".pluralize(count) %>
        </button>
        <%= by_kind %>
      </article>
      <div class="col-lg-8"><%= grid %></div>
    </div>
  <% else %>
    <%= grid %>
    <div class="mt-3"><%= by_kind %></div>
  <% end %>

  <aside class="modal fade" id="digital-assets-gallery" tabindex="-1" aria-labelledby="digital-assets-gallery-title" aria-hidden="true" data-mosaic-target="modal">
    <article class="modal-dialog modal-fullscreen">
      <section class="modal-content bg-black text-white rounded-0">
        <header class="modal-header border-secondary">
          <h2 class="modal-title h5 text-white" id="digital-assets-gallery-title"><%= title %></h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close gallery"></button>
        </header>
        <div class="modal-body p-0">
          <%= render gallery_component %>
        </div>
      </section>
    </article>
  </aside>
</section>
