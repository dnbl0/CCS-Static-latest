<%# Bootstrap classes do the styling; the digital-assets__ classes are the hooks for the behaviour (media_viewer_controller.js), the tests and the few
    rules Bootstrap has no class for (the viewer's height, the sliding panel: digital_assets.css). %>
<% if mosaic? %>
  <%= render NexusCcs::DigitalAssetsMosaicComponent.new(gallery: self) %>
<% else %>
<section class="digital-assets bg-black text-white" data-bs-theme="light" data-controller="media-viewer" aria-labelledby="digital-assets-heading">
  <h2 id="digital-assets-heading" class="visually-hidden">Digital <%= "asset".pluralize(count + media.size) %></h2>

  <div class="digital-assets__stage position-relative overflow-hidden p-3" data-media-viewer-target="stage">
    <%# Centring and clipping live on this inner area, not the stage itself: the Media metadata panel below is a sibling of it, not a child, so
        opening the panel (a position: absolute slide) can never feed back into the centred image's layout. %>
    <div class="digital-assets__media-area d-flex align-items-center justify-content-center w-100 h-100 overflow-hidden">
      <% if main %>
        <figure class="digital-assets__main w-100 m-0" data-media-viewer-target="main">
          <%= openseadragon_picture_tag osd_image, role: "img", "aria-label": alt(1), class: "digital-assets__viewer d-block w-100",
                data: { openseadragon: osd_config, media_viewer_target: "viewer" } %>
          <noscript><%= image_tag main.first, alt: alt(1), class: "digital-assets__noscript d-block mx-auto mw-100" %></noscript>
        </figure>
      <% end %>

      <% media.each_with_index do |item, index| %>
        <figure class="digital-assets__media w-100 m-0 p-3 text-center" id="<%= media_dom_id(index) %>" data-media-viewer-target="media">
          <% case item[:kind] %>
          <% when "video" %>
            <video controls preload="metadata" class="digital-assets__video d-block w-100 bg-black object-fit-contain" aria-label="<%= media_title(item) %>">
              <source src="<%= item[:url] %>" type="<%= item[:type] %>">
              <a class="link-light" href="<%= item[:url] %>">Download <%= media_title(item) %></a>
            </video>
          <% when "audio" %>
            <audio controls preload="metadata" class="digital-assets__audio w-100" aria-label="<%= media_title(item) %>">
              <source src="<%= item[:url] %>" type="<%= item[:type] %>">
              <a class="link-light" href="<%= item[:url] %>">Download <%= media_title(item) %></a>
            </audio>
          <% else %>
            <object data="<%= item[:url] %>" type="application/pdf" class="digital-assets__document d-block w-100 bg-white" aria-label="<%= media_title(item) %>">
              <%= link_to "Open #{media_title(item)} (PDF, opens in a new tab)", item[:url], target: "_blank", rel: "noopener", class: "digital-assets__pdf link-light" %>
            </object>
          <% end %>
          <figcaption class="mt-2"><%= media_title(item) %></figcaption>
        </figure>
      <% end %>
    </div>

    <% if metadata? %>
      <aside id="media-metadata" class="digital-assets__panel position-absolute top-0 end-0 bottom-0 z-2 d-flex flex-column mw-100 bg-white text-body shadow" aria-labelledby="media-metadata-heading" aria-hidden="true" data-media-viewer-target="panel">
        <header class="d-flex align-items-center justify-content-between py-2 ps-3 pe-2 border-bottom">
          <h3 id="media-metadata-heading" class="h6 m-0 fw-semibold">Media metadata</h3>
          <button type="button" class="btn btn-link p-2 lh-1" data-action="media-viewer#closePanel" aria-label="Close media metadata">
            <svg width="1em" height="1em" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.67" stroke-linecap="square" aria-hidden="true" focusable="false"><path d="M4.5 4.5l11 11M15.5 4.5l-11 11" /></svg>
          </button>
        </header>
        <dl class="digital-assets__list flex-grow-1 overflow-y-auto m-0">
          <% metadata.each do |label, text| %>
            <div class="px-3 py-3 border-bottom">
              <dt class="small fw-semibold text-uppercase text-secondary-emphasis"><%= label %></dt>
              <dd class="m-0"><%= text %></dd>
            </div>
          <% end %>
        </dl>
      </aside>
    <% end %>
  </div>

  <% if items.size > 1 %>
    <nav aria-label="Digital assets">
      <ul class="digital-assets__others list-unstyled d-flex flex-wrap justify-content-center gap-2 m-0 px-3 pb-3">
        <% items.each_with_index do |item, position| %>
          <% current = position.zero? %>
          <li>
            <% if item[:kind] == "image" %>
              <%= link_to item[:large], class: "digital-assets__other d-block border border-2 focus-ring #{current ? 'border-info' : 'border-transparent'}", target: "_blank", rel: "noopener",
                    aria: { current: (current ? "true" : nil) },
                    data: { action: "media-viewer#show", media_viewer_kind: "image", media_viewer_page: item[:index], media_viewer_alt: alt(item[:index] + 1) } do %>
                <%= image_tag item[:thumbnail], alt: "#{alt(item[:index] + 1)} (opens full size in a new tab)", loading: "lazy", class: "digital-assets__thumbnail d-block object-fit-contain bg-white border border-light-subtle" %>
              <% end %>
            <% else %>
              <%= link_to item[:url], class: "digital-assets__other d-block border border-2 focus-ring #{current ? 'border-info' : 'border-transparent'}", target: "_blank", rel: "noopener",
                    aria: { current: (current ? "true" : nil) },
                    data: { action: "media-viewer#show", media_viewer_kind: item[:kind], media_viewer_media: media_dom_id(item[:index]) } do %>
                <span class="digital-assets__thumbnail digital-assets__tile d-flex flex-column align-items-center justify-content-center gap-1 bg-primary text-white small">
                  <%= kind_icon(item[:kind]) %>
                  <span aria-hidden="true"><%= KIND_NAMES.fetch(item[:kind], "File") %></span>
                </span>
                <span class="visually-hidden"><%= KIND_NAMES.fetch(item[:kind], "File") %>: <%= media_title(item) %> (opens in a new tab)</span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>

  <section class="digital-assets__toolbar bg-body-tertiary text-body border-top" aria-label="Media toolbar">
    <div class="container d-flex align-items-center justify-content-between gap-3 py-2">
      <% if licence %>
        <p class="digital-assets__licence d-inline-flex align-items-center gap-2 m-0 px-2 py-1 bg-body-secondary small"><%= icon("media-copyright") %><span><span class="visually-hidden">Licence: </span><%= licence %></span></p>
      <% else %>
        <span></span>
      <% end %>
      <ul class="list-unstyled d-flex gap-1 m-0">
        <% if metadata? %>
          <li>
            <button type="button" class="btn btn-link fs-4 p-2 lh-1" aria-controls="media-metadata" aria-expanded="false" aria-label="Media metadata" title="Media metadata"
                    data-media-viewer-target="infoButton" data-action="media-viewer#togglePanel"><%= icon("media-info") %></button>
          </li>
        <% end %>
        <li>
          <button type="button" class="btn btn-link fs-4 p-2 lh-1" aria-label="Full screen" title="Full screen" hidden
                  data-media-viewer-target="fullscreenButton" data-action="media-viewer#toggleFullscreen"><%= icon("media-fullscreen") %></button>
        </li>
      </ul>
    </div>
  </section>
</section>
<% end %>
