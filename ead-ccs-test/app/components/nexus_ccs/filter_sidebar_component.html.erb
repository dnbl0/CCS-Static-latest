<search class="filter-sidebar" data-controller="filter-drawer facet-dropdowns"
        data-action="filter-drawer:open@window->filter-drawer#open keydown.esc@window->filter-drawer#escape">
  <div class="filter-drawer__header d-lg-none">
    <h2 id="filter-drawer-title" class="filter-drawer__title">Filters</h2>
    <button type="button" class="filter-drawer__close" data-filter-drawer-target="close" data-action="filter-drawer#close">
      Close
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
    </button>
  </div>

  <p class="filter-sidebar__advanced">
    <%= link_to advanced_filters_path do %>Advanced filters <span aria-hidden="true">&rarr;</span><% end %>
  </p>

  <div class="filter-sidebar__summary">
    <h2 class="filter-sidebar__heading">Search filters<%= " (#{applied_count})" if applied_count.positive? %></h2>
    <% if applied_count.positive? %>
      <%= link_to clear_filters_path, class: "filter-sidebar__clear" do %>Clear all <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg><% end %>
    <% end %>
  </div>

  <div class="filter-sidebar__switches" role="group" aria-labelledby="digital-switch-label">
    <span class="filter-sidebar__switch-caption" id="digital-switch-label">Show only</span>
    <%= link_to digital_toggle_path, class: "filter-switch#{' is-on' if digital_only?}", role: "switch", "aria-checked": digital_only?.to_s do %>
      <span class="filter-switch__track" aria-hidden="true"><span class="filter-switch__knob"></span></span>
      <span class="filter-switch__label">Records with digital assets</span>
    <% end %>
  </div>

  <% facet_group_names.each do |groupname| %>
    <% fields = facet_fields_in_group(groupname) %>
    <%= render group_component_class.new(id: groupname) do |component| %>
      <% component.with_body do %>
        <%= render Blacklight::FacetComponent.with_collection(fields, response: response) %>
      <% end %>
    <% end %>
  <% end %>
</search>
