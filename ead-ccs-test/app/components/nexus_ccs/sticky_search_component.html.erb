<%# inert + aria-hidden while it is off screen, so keyboard and screen reader users never land in a hidden bar %>
<div class="sticky-search position-fixed top-0 start-0 end-0" inert aria-hidden="true"
     data-controller="sticky-search" data-sticky-search-banner-value="<%= BANNERS %>">
  <div class="container sticky-search__inner py-2">
    <%= form_with url: search_catalog_path, method: :get, class: "input-group", html: { role: "search", "aria-label": "Search Cultural Collections" } do |form| %>
      <%= hidden_field_tag :search_field, "all_fields", id: nil %>
      <%= form.label :q, "Search Cultural Collections", for: "sticky-search-q", class: "visually-hidden" %>
      <%= form.search_field :q, value: query, id: "sticky-search-q", class: "form-control", placeholder: "Search", autocomplete: "off", maxlength: QueryRules::MAX_LENGTH %>
      <button type="submit" class="btn btn-primary sticky-search__submit">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="visually-hidden">Search</span>
      </button>
    <% end %>
  </div>
</div>
