<nav class="breadcrumb-bar" aria-label="Breadcrumb">
  <ol class="breadcrumb-bar__trail">
    <li class="breadcrumb-bar__item">
      <%= link_to helpers.root_path, class: "breadcrumb-bar__home", aria: { label: "Home" } do %>
        <%= image_tag "site/home.svg", alt: "", width: 16, height: 16 %>
      <% end %>
    </li>
    <% items.each do |label, href| %>
      <% if href %>
        <li class="breadcrumb-bar__item"><%= link_to label, href %></li>
      <% else %>
        <li class="breadcrumb-bar__item" aria-current="page"><span><%= label %></span></li>
      <% end %>
    <% end %>
  </ol>

  <%# Narrow screens: one link back to the parent page %>
  <%= link_to (parent ? parent.last : helpers.root_path), class: "breadcrumb-bar__back" do %>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
    <span><%= parent ? parent.first : "Cultural Collections" %></span>
  <% end %>
</nav>
