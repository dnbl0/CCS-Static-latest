<%= content_tag(url ? :a : :span, **wrapper_options) do %>
  <% if icons.any? %>
    <span class="licence-badge__icons"><% icons.each do |file| %><%= image_tag file, alt: "", class: "licence-badge__icon", width: 20, height: 20 %><% end %></span>
  <% end %>
  <span class="licence-badge__label"><%= licence %></span>
  <% if url %><span class="visually-hidden">(opens in new window)</span><% end %>
<% end %>
