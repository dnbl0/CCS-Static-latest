<%# Floating "back to top" button, after the University Library Search's: it fades in once the page is scrolled. %>
<button type="button" class="back-to-top" aria-label="Back to top" hidden
        data-controller="back-to-top" data-action="back-to-top#toTop scroll@window->back-to-top#update resize@window->back-to-top#update">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 8l-8 8 1.05 1.05L12 10.1l6.95 6.95L20 16z" fill="currentColor" /></svg>
</button>
