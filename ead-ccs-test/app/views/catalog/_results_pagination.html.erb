<%# Blacklight's, with a window of two pages either side of the current one and one at each end (1 … 4 5 6 7 8 … 74) %>
<% if show_pagination? and @response.total_pages > 1 %>
  <%= render Blacklight::Response::PaginationComponent.new(response: @response,
    classes: 'paginate-section', window: 2, outer_window: 1) %>
<% end %>
