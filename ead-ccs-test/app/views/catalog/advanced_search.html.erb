<% @page_title = t("advanced_search.page_title") + " - " + application_name %>

<section class="search-banner advanced-banner" aria-labelledby="adv-title">
  <div class="search-banner__inner">
    <h1 id="adv-title" class="search-banner__title"><%= t("advanced_search.banner_title") %></h1>
    <p class="search-banner__desc"><%= t("advanced_search.banner_description") %></p>
  </div>
</section>

<div class="advanced-page">
  <div class="advanced-page__form"><%= render "advanced_search_form" %></div>
  <div class="advanced-page__help"><%= render "advanced_search_help" %></div>
</div>
