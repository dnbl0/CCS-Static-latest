<%# For a visitor with JavaScript turned off: the menu, and the search pop-up need it; searching and reading do not. %>
<noscript>
  <div class="noscript-notice" role="note">
    JavaScript is turned off in your browser, so the menu and the search pop-up will not open. You can still
    <%= link_to "search all records", search_catalog_path(search_field: "all_fields") %> and read records.
  </div>
</noscript>
