<%# The site has one design, the light one, whatever the browser or device is set to (light, dark or auto). The meta tag keeps the
    browser's own controls and scrollbars light; the script pins Bootstrap's colour mode, which Blacklight's script would otherwise
    switch to dark when the device changes mode while a page is open. %>
<meta name="color-scheme" content="light">
<script>
  (() => {
    const root = document.documentElement
    const pin = () => { if (root.getAttribute("data-bs-theme") !== "light") root.setAttribute("data-bs-theme", "light") }
    pin()
    new MutationObserver(pin).observe(root, { attributes: true, attributeFilter: [ "data-bs-theme" ] })
  })()
</script>
