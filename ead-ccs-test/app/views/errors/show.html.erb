<%# An error page in the site chrome (ErrorsController). Wording after the University's plain-language patterns: what happened, what
    to do, where to go, how to reach the team. Never a stack trace, never blame. %>
<% copy = {
  "404" => @record ?
    { title: "We can't find this record", lead: "The record may have been withdrawn, or the link may be out of date or mistyped. Records can move when the collections are updated." } :
    { title: "Page not found", lead: "The page you were looking for isn't here. The address may be mistyped, or the page may have moved." },
  "500" => { title: "Something went wrong", lead: "We couldn't complete your request. Nothing you did caused this. Please try again in a few minutes." },
  "422" => { title: "Your request couldn't be completed", lead: "The page may have been open for a long time, or the request was rejected. Go back, refresh the page and try again." },
  "400" => { title: "We couldn't read that address", lead: "The address contains something we can't read, such as a broken or incomplete web address. Check it, or start a new search." },
  "406" => { title: "We can't show it that way", lead: "This page isn't available in the form that was asked for. Go to the page itself, or start a new search." }
}.fetch(@code) %>
<% content_for :title, "#{copy[:title]} - Cultural Collections Search - University of Melbourne" %>
<% content_for :body_class, "page-error" %>

<%= render NexusCcs::PageBannerComponent.new(title: copy[:title]) %>

<main id="main-content" class="error-page">
  <div class="error-page__inner">
    <p class="error-page__lead"><%= copy[:lead] %></p>

    <section aria-labelledby="error-next">
      <h2 id="error-next" class="error-page__heading">What you can do</h2>
      <ul class="error-page__links">
        <% if @code == "500" && (request.get? || request.head?) %>
          <li><%= link_to @path, class: "arrow-link" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %>Try this page again<% end %></li>
        <% end %>
        <li><%= link_to search_catalog_path(search_field: "all_fields"), class: "arrow-link" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %>Search all records<% end %></li>
        <li><%= link_to collections_path, class: "arrow-link" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %>Browse collections<% end %></li>
        <li><%= link_to root_path, class: "arrow-link" do %><%= image_tag "site/icon-arrow-footer.svg", alt: "" %>Go to the home page<% end %></li>
      </ul>
    </section>

    <p class="error-page__help">Still stuck? <%= link_to "Contact the collections team", help_path(anchor: "contact-us") %> and tell us what you were trying to do.</p>
    <p class="error-page__code">Error <%= @code %></p>
  </div>
</main>
