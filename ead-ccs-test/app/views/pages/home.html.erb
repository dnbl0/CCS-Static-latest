<%# Home page, from public/index.html of the static site %>
<% content_for :title, "Cultural Collections Search - University of Melbourne" %>
<% content_for :body_class, "page-home ccs-home" %>
<main id="main-content" class="home-main-content">

    <!-- Section component: hero banner (162:1245 / 162:3462) -->
    <section class="ccs-section ccs-section--hero" aria-labelledby="home-title">
      <div class="ccs-hero">
        <div class="ccs-hero__content">
          <div class="ccs-hero__group">
            <div class="ccs-hero__group">
              <h1 id="home-title" class="ccs-hero__title">Cultural Collections</h1>
              <p class="ccs-hero__text">CCS brings together the University of Melbourne’s rich and diverse cultural collections into a single discovery experience.</p>
            </div>
            <div class="ccs-hero__search">
              <%= render NexusCcs::HeroSearchComponent.new(blacklight_config: blacklight_config) %>
            </div>
          </div>
        </div>
        <div class="ccs-hero__media"><img class="ccs-hero__image" src="<%= asset_path("site/hero-handling-objects.jpg") %>" alt="Two people wearing gloves handle collection objects in a storeroom"><%= render NexusCcs::SavedBarComponent.new(placement: :hero) %></div>
      </div>
    </section>

    <!-- Section component: introduction (162:1273 / 162:3463) -->
    <section class="ccs-section home-about" aria-label="About CCS">
      <div class="ccs-section__inner home-about__inner">
        <h2 class="home-about__statement">Welcome to CCS. A New Way to Discover the University’s Cultural Collections</h2>
        <p class="home-about__text">The University of Melbourne's cultural collections are unrivalled among Australian universities, spanning historical and contemporary items in the fields of visual arts, rare books, medical history, botany, zoology, and geology, as well as the disciplines of science, engineering and information technology. The University is also custodian to extensive archival holdings, and significant Aboriginal and Torres Strait Islander cultural heritage material, which is of greatest importance to communities of origin and their descendants.</p>
      </div>
    </section>

        <section class="ccs-section home-collections" aria-labelledby="browse-collections">
      <div class="ccs-section__inner">
        <header class="home-collections__header">
          <h2 id="browse-collections" class="ccs-section__heading">Collections currently available in CCS</h2>
          <p class="home-collections__description">CCS brings together the University of Melbourne’s 30+ cultural collections via a single discovery experience. CCS is part of a broader vision to make the University’s cultural collections more discoverable, accessible and connected, supporting teaching, learning, research and public use. All University collections will join CCS over time.</p>
        </header>
        <ul class="home-collections__list">
        <li class="home-card">
          <div class="home-card__media"><img class="home-card__image" src="<%= asset_path("site/banners/grainger-museum-card.jpg") %>" alt=""></div>
          <div class="home-card__body">
            <h3 class="home-card__title"><a class="home-card__link" href="<%= collection_results_path("grainger-museum") %>">Grainger Museum Collection</a></h3>
            <p class="home-card__text">Australian musician and composer Percy Grainger established the Grainger Museum and Collection in 1938, motivated by the desire to interpret and contextualise his creative achievements and cultural environment. The Collection is an internationally significant archive of over 100,000 items, spanning a range of disciplines, from experimental sound technology and musical instruments, to costumes, ethnography, art and design. The collection is brought to life through collaboration with students, academic partners and artists and their creative work and production.</p>
            <a class="home-textbutton" href="<%= search_action_path(f: { collection_ssim: [ "Grainger Museum Collection" ] }) %>">Search this Collection<span class="sr-only"> (Grainger Museum Collection)</span><img class="home-textbutton__image" src="<%= asset_path("site/icon-arrow-right.svg") %>" alt=""></a>
          </div>
        </li>
        <li class="home-card">
          <div class="home-card__media"><img class="home-card__image" src="<%= asset_path("site/banners/harry-brookes-allen-museum.jpg") %>" alt=""></div>
          <div class="home-card__body">
            <h3 class="home-card__title"><a class="home-card__link" href="<%= collection_results_path("harry-brookes-allen-museum") %>">Harry Brookes Allen Museum of Anatomy and Pathology</a></h3>
            <p class="home-card__text">The Harry Brookes Allen Museum of Anatomy and Pathology is one of Australia's largest collections of human tissue specimens, animal anatomy specimens, and historical anatomical models, offering students and researchers a unique insight into the human body.</p>
            <a class="home-textbutton" href="<%= search_action_path(f: { collection_ssim: [ "Harry Brookes Allen Museum of Anatomy and Pathology" ] }) %>">Search this Collection<span class="sr-only"> (Harry Brookes Allen Museum of Anatomy and Pathology)</span><img class="home-textbutton__image" src="<%= asset_path("site/icon-arrow-right.svg") %>" alt=""></a>
          </div>
        </li>
        <li class="home-card">
          <div class="home-card__media"><img class="home-card__image" src="<%= asset_path("site/banners/henry-forman-atkinson-dental-museum.jpg") %>" alt=""></div>
          <div class="home-card__body">
            <h3 class="home-card__title"><a class="home-card__link" href="<%= collection_results_path("henry-forman-atkinson-dental-museum") %>">Henry Forman Atkinson Dental Museum</a></h3>
            <p class="home-card__text">Showcases the intriguing history of dental health and development of the dental professions and dental education. The Henry Forman Atkinson Dental Museum collection is the oldest and most significant dental collection in Australia, tracing its origins back to 1884.</p>
            <a class="home-textbutton" href="<%= search_action_path(f: { collection_ssim: [ "Henry Forman Atkinson Dental Museum" ] }) %>">Search this Collection<span class="sr-only"> (Henry Forman Atkinson Dental Museum)</span><img class="home-textbutton__image" src="<%= asset_path("site/icon-arrow-right.svg") %>" alt=""></a>
          </div>
        </li>
        <li class="home-card">
          <div class="home-card__media"><img class="home-card__image" src="<%= asset_path("site/banners/medical-history-museum.jpg") %>" alt=""></div>
          <div class="home-card__body">
            <h3 class="home-card__title"><a class="home-card__link" href="<%= collection_results_path("medical-history-museum") %>">Medical History Museum</a></h3>
            <p class="home-card__text">Since its inception in 1967, the Medical History Museum has developed a diverse and varied collection of over 13,000 items encompassing documents, photographs, artefacts, artworks, medical and scientific equipment and associated research material, encompassing the history of medicine in Victoria, Australia and internationally.</p>
            <a class="home-textbutton" href="<%= search_action_path(f: { collection_ssim: [ "Medical History Museum" ] }) %>">Search this Collection<span class="sr-only"> (Medical History Museum)</span><img class="home-textbutton__image" src="<%= asset_path("site/icon-arrow-right.svg") %>" alt=""></a>
          </div>
        </li>
        <li class="home-card">
          <div class="home-card__media"><img class="home-card__image" src="<%= asset_path("site/banners/university-art-collection.jpg") %>" alt=""></div>
          <div class="home-card__body">
            <h3 class="home-card__title"><a class="home-card__link" href="<%= collection_results_path("university-art-collection") %>">University Art Collection</a></h3>
            <p class="home-card__text">The University of Melbourne Art Collection is the largest University-based art collection in Australia, comprising over 18,000 artworks. The collection includes major holdings of paintings, prints and drawings, ceramics, and sculpture, including contemporary Australian art and contemporary Aboriginal and Torres Strait Islander Art.</p>
            <a class="home-textbutton" href="<%= search_action_path(f: { collection_ssim: [ "University Art Collection" ] }) %>">Search this Collection<span class="sr-only"> (University Art Collection)</span><img class="home-textbutton__image" src="<%= asset_path("site/icon-arrow-right.svg") %>" alt=""></a>
          </div>
        </li>
        <li class="home-card">
          <div class="home-card__media"><img class="home-card__image" src="<%= asset_path("site/collections-breakout.jpg") %>" alt=""></div>
          <div class="home-card__body">
            <h3 class="home-card__title"><a class="home-card__link" href="https://museumsandcollections.unimelb.edu.au/collections">Cultural Collections</a></h3>
            <p class="home-card__text">CCS will make accessible the University of Melbourne’s 30+ cultural collections via a single discovery experience. More collections will be available over time; in the meantime, for more information about other cultural collections at the University of Melbourne, visit <a href="https://museumsandcollections.unimelb.edu.au/collections">museumsandcollections.unimelb.edu.au/collections</a>.</p>
            <a class="home-textbutton" href="https://museumsandcollections.unimelb.edu.au/collections">University museums and collections<span class="sr-only"> (opens the Museums and Collections website)</span><img class="home-textbutton__image" src="<%= asset_path("site/icon-arrow-right.svg") %>" alt=""></a>
          </div>
        </li>
        </ul>
      </div>
    </section>

  </main>

<%# The Acknowledgement of Country, once a day per browser (see CountryAcknowledgement) %>
<%= render "catalog/country_acknowledgement" if acknowledge_country? %>
