<% content_for :title, "#{@collection["name"]} — Cultural Collections Search — University of Melbourne" %>
<% content_for :body_class, "page-collection-landing" %>
<% search_href = search_catalog_path(f: { collection_ssim: [ @facet_value ] }) %>
<%= render "pages/breadcrumbs", trail: [ [ "Browse collections", collections_path ], [ @collection["name"], nil ] ] %>
<header class="campaign-banner-split campaign-banner-split--dark" role="presentation">
  <div class="campaign-banner-split__img">
    <%= image_tag "site/banners/#{@collection["banner"]}", class: "campaign-banner-split__img-inner", alt: "" %>
  </div>
  <div class="max campaign-banner-split__inner">
    <div class="campaign-banner-split__content">
      <div class="campaign-banner-split__content-inner">
        <h1 class="campaign-banner-split__heading"><%= @collection["name"] %></h1>
        <p class="campaign-banner-split__text"><%= @collection["blurb"] %></p>
        <a href="<%= search_href %>" class="button">Explore the collection</a>
      </div>
    </div>
  </div>
</header>

<main class="collection-landing-main-content" id="main-content">
  <div class="collection-layout">
    <div class="collection-layout__content">
      <section class="collection-section" aria-labelledby="h-about">
        <h2 class="collection-section__heading-about-this-collection" id="h-about">About this collection</h2>
        <p class="collection-section__text"><%= sanitize @collection["about"] %></p>
        <% if @collection["advisory"] %>
          <p class="notice notice--warning collection-section__notice"><%= sanitize @collection["advisory"] %></p>
        <% end %>
      </section>
      <section class="collection-section" aria-labelledby="h-details">
        <h2 class="collection-section__heading-collection-details" id="h-details">Collection details</h2>
        <dl class="def-table">
          <% @collection["details"].each do |detail| %>
            <div class="def-table__row">
              <dt class="def-table__term"><%= detail["label"] %></dt>
              <dd class="def-table__definition"><span class="def-table__text"><%= detail["value"] %></span></dd>
            </div>
          <% end %>
        </dl>
      </section>
    </div>
    <aside class="contact-box collection-layout__aside" aria-labelledby="h-visit">
      <h2 class="contact-box__title" id="h-visit">Visitors information</h2>
      <dl class="contact-box__list">
        <% @collection["visit"].each do |item| %>
          <div class="contact-box__item">
            <dt class="contact-box__term"><%= item["label"] %></dt>
            <dd class="contact-box__definition">
              <% item["paragraphs"].each do |paragraph| %>
                <p class="contact-box__para"><%= sanitize paragraph, attributes: %w[href target rel class] %></p>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
      <p class="contact-box__source"><a class="contact-box__link" href="<%= @collection["visit_url"] %>" target="_blank" rel="noopener">Full visitors information<span class="sr-only"> (opens in a new tab)</span></a></p>
    </aside>
  </div>

  <section class="ct-listing ct-listing--alt" aria-labelledby="h-explore">
    <div class="ct-listing__inner">
      <h2 class="ct-listing__title" id="h-explore">Explore further</h2>
      <ul class="ct-listing__list ct-listing__list--pathfinder ct-listing__list--four">
        <li class="ct-listing__item"><a class="pathfinder-alt__link" href="<%= search_href %>"><span class="pathfinder-alt__content"><span class="pathfinder-alt__title">Search this collection</span><span class="pathfinder-alt__summary">Search and filter every record in the <%= @collection["name"] %>.</span></span></a></li>
        <li class="ct-listing__item"><a class="pathfinder-alt__link" href="<%= collections_path %>"><span class="pathfinder-alt__content"><span class="pathfinder-alt__title">Browse all collections</span><span class="pathfinder-alt__summary">Return to the five University cultural collections.</span></span></a></li>
        <li class="ct-listing__item"><a class="pathfinder-alt__link" href="<%= help_path %>"><span class="pathfinder-alt__content"><span class="pathfinder-alt__title">Help and support</span><span class="pathfinder-alt__summary">Searching, using and requesting items from the collections.</span></span></a></li>
        <li class="ct-listing__item"><a class="pathfinder-alt__link" href="<%= @collection["website"]["url"] %>" target="_blank" rel="noopener"><span class="pathfinder-alt__content"><span class="pathfinder-alt__title">Visit the museum website<span class="sr-only"> (opens in a new tab)</span></span><span class="pathfinder-alt__summary"><%= @collection["website"]["summary"] %></span></span></a></li>
      </ul>
    </div>
  </section>
</main>
